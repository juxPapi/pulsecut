{
  "name": "pulsecut",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PulseCut — turn long videos into short clips, entirely on your own machine.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node server/index.js\" \"vite --port 5190 --strictPort\"",
    "api": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js --serve-build"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@huggingface/transformers": "^4.3.2",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.11"
  }
}
